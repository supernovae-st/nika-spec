# SPDX-License-Identifier: Apache-2.0
# yaml-language-server: $schema=https://nika.sh/spec/v1/workflow.schema.json
#
# PROPOSED · NOT IN canon/templates/registry.yaml
# lookup-and-enrich · identifier → read directory → typed facts.
# Provider-neutral: the "CRM" is a JSON file. Bindings pick HubSpot later.
# PATTERN P01. Compiler must not copy this per SaaS.
#
#   [read_dir] ──▶ [pick] ──▶ [facts]
#   nika:read       jq         validate
nika: lookup-and-enrich-proposed
model: mock/echo
inputs:
  customer_id:
    type: string
    required: true
    default: "CUST-1"
const:
  directory_path: "./fixtures/customers.json"  # SLOT: binding, not structure
permits:
  tools: ["nika:read", "nika:jq", "nika:validate", "nika:assert"]
  fs: { read: ["./fixtures/customers.json"] }
tasks:
  read_dir:
    invoke:
      tool: nika:read
      args: { path: "${{ const.directory_path }}" }
    # Missing or malformed fixture data is a failure, never a fabricated
    # successful CRM lookup. Rehearse beside the fixtures/ directory.
  pick:
    with:
      dir: ${{ tasks.read_dir.output }}
      id: ${{ inputs.customer_id }}
    invoke:
      tool: nika:jq
      args:
        input:
          directory: ${{ with.dir }}
          id: ${{ with.id }}
        expression: '. as $lookup | ($lookup.directory | fromjson)[$lookup.id]'
  facts:
    with: { row: "${{ tasks.pick.output }}" }
    invoke:
      tool: nika:validate
      args:
        data: ${{ with.row }}
        format: json
        schema:
          type: object
          required: [name, tier]
          properties:
            name: { type: string }
            tier: { type: string }
  admit:
    with:
      valid: ${{ tasks.facts.output.valid }}
    invoke:
      tool: nika:assert
      args:
        condition: ${{ with.valid }}
        message: "The selected customer must have typed name and tier fields"
  result:
    after: { admit: success }
    with:
      row: ${{ tasks.pick.output }}
    invoke:
      tool: nika:jq
      args:
        input: ${{ with.row }}
        expression: "."
outputs:
  facts: ${{ tasks.result.output }}
