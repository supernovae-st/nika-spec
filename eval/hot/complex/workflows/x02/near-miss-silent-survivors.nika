# SPDX-License-Identifier: Apache-2.0
# yaml-language-server: $schema=https://nika.sh/spec/v1/workflow.schema.json
#
# X02 · NEAR-MISS · filter the failures, add up what is left, report the sum.
# The batch survives and the run is green. The total is short by one record and
# nothing says so. Static check: valid. Judge: outputs_contract.
nika: x02-near-miss-silent-survivors
model: mock/echo

const:
  items:
    - { id: "inv-1", amount: 40 }
    - { id: "inv-2", amount: "forty" }
    - { id: "inv-3", amount: 25 }

permits:
  tools: ["nika:jq", "nika:read"]
  fs:
    read: ["./fixtures/overrides.json"]

tasks:
  overrides:
    invoke:
      tool: "nika:read"
      args:
        path: "./fixtures/overrides.json"
    on_error:
      on_codes: [NIKA-BUILTIN-READ-001]
      recover: "{}"

  convert:
    for_each:
      items: ${{ const.items }}
      max_parallel: 2
      fail_fast: false
    on_error:
      recover: null
    invoke:
      tool: "nika:jq"
      args:
        input: ${{ item }}
        expression: 'if (.amount | type) == "number" then {id: .id, cents: (.amount * 100)} else error("amount is not a number") end'

  account:
    with:
      results: ${{ tasks.convert.output }}
      overrides: ${{ tasks.overrides.output }}
    invoke:
      tool: "nika:jq"
      args:
        input: { results: "${{ with.results }}", items: "${{ const.items }}", overrides: "${{ with.overrides }}" }
        expression: '. as $r | {overrides: ($r.overrides | fromjson), total_cents: ([$r.results[] | select(. != null) | .cents] | add)}'

outputs:
  total_cents: ${{ tasks.account.output.total_cents }}
