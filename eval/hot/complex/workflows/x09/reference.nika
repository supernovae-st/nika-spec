# SPDX-License-Identifier: Apache-2.0
# yaml-language-server: $schema=https://nika.sh/spec/v1/workflow.schema.json
#
# X09 · reference · when every candidate breaks a hard constraint, the answer is "none", with the reasons.
#
#   [quotes]──▶[parse]──▶[select]──▶ selected · reason · rejected
#    read       jq        jq
#
# Hard constraints are never relaxed to produce a choice. An empty list and a
# list where nothing fits are different answers.
nika: x09-reject-all-selection
model: mock/echo

const:
  max_total_eur: 5000
  max_delivery_days: 14

permits:
  tools: ["nika:jq", "nika:read"]
  fs:
    read: ["./fixtures/quotes.json"]

tasks:
  quotes:
    invoke:
      tool: "nika:read"
      args:
        path: "./fixtures/quotes.json"

  select:
    with:
      raw: ${{ tasks.quotes.output }}
    invoke:
      tool: "nika:jq"
      args:
        input: { raw: "${{ with.raw }}", max_total: "${{ const.max_total_eur }}", max_days: "${{ const.max_delivery_days }}" }
        expression: '. as $r | ($r.raw | fromjson) as $q | [$q[] | . + {violations: ([if .total_eur > $r.max_total then "over_budget" else empty end, if .delivery_days > $r.max_days then "late" else empty end])}] as $judged | [$judged[] | select((.violations | length) == 0)] as $fit | {selected: (if ($fit | length) == 0 then null else ($fit | min_by(.total_eur) | .id) end), reason: (if ($q | length) == 0 then "no_candidates" elif ($fit | length) == 0 then "none_fit" else "cheapest_fit" end), rejected: [$judged[] | select((.violations | length) > 0) | {id, violations}]}'

outputs:
  selected: ${{ tasks.select.output.selected }}
  reason: ${{ tasks.select.output.reason }}
  rejected: ${{ tasks.select.output.rejected }}
