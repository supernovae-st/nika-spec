# SPDX-License-Identifier: Apache-2.0
# yaml-language-server: $schema=https://nika.sh/spec/v1/workflow.schema.json
#
# X01 · reference · fan out, account for every source, ask with the facts, publish only on yes.
#
#   [digest ∥×N]──▶[coverage]──▶[merge]──▶[human ⏸]──yes──▶[publish]
#
# The person sees what will be written, where, and which sources are missing.
# A refusal is a value, so the write reads the answer itself.
nika: x01-fanout-approve-publish
model: mock/echo

const:
  destination: "./out/report.md"
  sources:
    - { id: "src-a", ok: true, text: "Alpha shipped on time." }
    - { id: "src-b", ok: false, text: "" }
    - { id: "src-c", ok: true, text: "Gamma slipped one week." }

permits:
  tools: ["nika:jq", "nika:prompt", "nika:write"]
  fs:
    write: ["./out/report.md"]

tasks:
  digest:
    for_each:
      items: ${{ const.sources }}
      max_parallel: 2
      fail_fast: false
    on_error:
      recover: null
    invoke:
      tool: "nika:jq"
      args:
        input: ${{ item }}
        expression: 'if .ok then {id: .id, line: .text} else error("source unreadable") end'

  coverage:
    with:
      digests: ${{ tasks.digest.output }}
    invoke:
      tool: "nika:jq"
      args:
        input: { digests: "${{ with.digests }}", sources: "${{ const.sources }}" }
        expression: '. as $r | [range(0; ($r.sources | length))] | {total: length, missing_ids: [.[] | select($r.digests[.] == null) | $r.sources[.].id], lines: [$r.digests[] | select(. != null) | .line]}'

  merge:
    with:
      coverage: ${{ tasks.coverage.output }}
    infer:
      max_tokens: 600
      prompt: "Merge these lines into a short status report: ${{ with.coverage.lines }}"
      schema:
        type: object
        additionalProperties: false
        required: [report]
        properties:
          report: { type: string, minLength: 1 }

  human:
    with:
      coverage: ${{ tasks.coverage.output }}
      report: ${{ tasks.merge.output.report }}
    invoke:
      tool: "nika:prompt"
      args:
        message: "Publish to ${{ const.destination }}? Missing sources: ${{ with.coverage.missing_ids }}. Report: ${{ with.report }}"

  publish:
    with:
      go: ${{ tasks.human.output }}
      report: ${{ tasks.merge.output.report }}
    when: ${{ with.go == true }}
    invoke:
      tool: "nika:write"
      args:
        path: "${{ const.destination }}"
        content: "${{ with.report }}"

outputs:
  published: ${{ tasks.publish.status }}
  missing_ids: ${{ tasks.coverage.output.missing_ids }}
