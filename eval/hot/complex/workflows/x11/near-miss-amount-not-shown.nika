# SPDX-License-Identifier: Apache-2.0
# yaml-language-server: $schema=https://nika.sh/spec/v1/workflow.schema.json
#
# X11 · NEAR-MISS · the question names the account and the order, and leaves the amount out.
# Closer, and still open on the one fact that moves money.
# Static check: valid. Judge: gate_binds_effect_facts.
nika: x11-near-miss-amount-not-shown
model: mock/echo

const:
  account: "ACME"
  order_id: "A-1043"
  amount_eur: 40

permits:
  tools: ["nika:prompt", "nika:write"]
  fs:
    write: ["./out/refund.txt"]

tasks:
  human:
    invoke:
      tool: "nika:prompt"
      args:
        message: "Refund ${{ const.account }} for order ${{ const.order_id }}?"

  refund:
    with:
      go: ${{ tasks.human.output }}
    when: ${{ with.go == true }}
    invoke:
      tool: "nika:write"
      args:
        path: "./out/refund.txt"
        content: "refund ${{ const.amount_eur }} EUR to ${{ const.account }} for order ${{ const.order_id }}"

outputs:
  refunded: ${{ tasks.refund.status }}
