# SPDX-License-Identifier: Apache-2.0
# yaml-language-server: $schema=https://nika.sh/spec/v1/workflow.schema.json
#
# X13 · NEAR-MISS · the stage also reads a step that merely ran.
# This is the class of the original KG01 golden, in its smallest form. If
# `prepare` failed the stage would be cancelled, not skipped, so the skip is not
# CERTAIN and no oracle may refuse: the engine gives a consent advisory and the
# file is valid. `prepare` succeeding is the ordinary run, and on no it writes.
# Static check: valid. Judge: effects_gated. Behaviour: rejects.
nika: x13-near-miss-stage-also-reads-a-step-that-ran
model: mock/echo

const:
  note: "Release 2.4.1 is ready."

permits:
  tools: ["nika:jq", "nika:prompt", "nika:write"]
  fs:
    write: ["./out/report.md"]

tasks:
  human:
    invoke:
      tool: "nika:prompt"
      args:
        message: "Publish this note to ./out/report.md? ${{ const.note }}"

  prepare:
    invoke:
      tool: "nika:jq"
      args:
        input: ${{ const.note }}
        expression: "."

  stage:
    with:
      go: ${{ tasks.human.output }}
      note: ${{ tasks.prepare.output }}
    when: ${{ with.go == true }}
    invoke:
      tool: "nika:jq"
      args:
        input: ${{ with.note }}
        expression: "."

  publish:
    with:
      staged: ${{ tasks.stage.output }}
    invoke:
      tool: "nika:write"
      args:
        path: "./out/report.md"
        content: "Release note: ${{ with.staged }}"

outputs:
  published: ${{ tasks.publish.status }}
