# SPDX-License-Identifier: Apache-2.0
# yaml-language-server: $schema=https://nika.sh/spec/v1/workflow.schema.json
#
# X06 · base · the ACCEPTED workflow every edit candidate is compared with.
#
#   [classify]──▶[within_limit]──▶[notify]
#    infer         jq               nika:notify → the team webhook
#
# The webhook is named by its role, so swapping the vendor touches the secret's
# key and the granted host and nothing else. `refund_limit_eur` is policy.
nika: x06-refund-triage
model: mock/echo

inputs:
  ticket:
    type: string
    required: true
  amount_eur:
    type: integer
    required: true

const:
  refund_limit_eur: 100

secrets:
  webhook:
    source: env
    key: SLACK_WEBHOOK_URL
    egress:
      - to: "nika:notify"
        host_from_self: true

permits:
  tools: ["nika:jq", "nika:notify"]
  net:
    http: ["hooks.slack.test"]

tasks:
  classify:
    infer:
      max_tokens: 200
      prompt: "Classify this support ticket. Ticket: ${{ inputs.ticket }}"
      schema:
        type: object
        additionalProperties: false
        required: [class]
        properties:
          class: { type: string, enum: [billing, login, other] }

  within_limit:
    invoke:
      tool: "nika:jq"
      args:
        input: { amount: "${{ inputs.amount_eur }}", limit: "${{ const.refund_limit_eur }}" }
        expression: ".amount <= .limit"

  notify:
    with:
      verdict: ${{ tasks.classify.output }}
      within_limit: ${{ tasks.within_limit.output }}
    invoke:
      tool: "nika:notify"
      args:
        channel: webhook
        target: "${{ secrets.webhook }}"
        message: "Ticket class ${{ with.verdict.class }} · within refund limit: ${{ with.within_limit }}"
        severity: info

outputs:
  class: ${{ tasks.classify.output.class }}
  within_limit: ${{ tasks.within_limit.output }}
