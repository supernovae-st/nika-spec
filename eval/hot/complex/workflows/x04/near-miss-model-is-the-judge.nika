# SPDX-License-Identifier: Apache-2.0
# yaml-language-server: $schema=https://nika.sh/spec/v1/workflow.schema.json
#
# X04 · NEAR-MISS · a model call decides whether the text is accepted.
# The threshold is policy. Asking a model to apply it makes the policy a sample.
# Static check: valid. Judge: decision_deterministic.
nika: x04-near-miss-model-is-the-judge
model: mock/echo

const:
  brief: "Explain the refund policy to a customer in three sentences."
  accept_at: 80

permits:
  tools: ["nika:jq"]

tasks:
  draft:
    infer:
      max_tokens: 400
      prompt: "Draft this deliverable: ${{ const.brief }}"
      schema:
        type: object
        additionalProperties: false
        required: [text]
        properties:
          text: { type: string, minLength: 1 }

  critique_1:
    with:
      candidate: ${{ tasks.draft.output.text }}
    infer:
      max_tokens: 400
      prompt: "Critique this candidate against the brief and name one repair. Brief: ${{ const.brief }} Candidate: ${{ with.candidate }}"
      schema:
        type: object
        additionalProperties: false
        required: [score, repair]
        properties:
          score: { type: integer, minimum: 0, maximum: 100 }
          repair: { type: string, minLength: 1 }

  repair_1:
    with:
      candidate: ${{ tasks.draft.output.text }}
      repair: ${{ tasks.critique_1.output.repair }}
    infer:
      max_tokens: 400
      prompt: "Revise the candidate using the repair. Candidate: ${{ with.candidate }} Repair: ${{ with.repair }}"
      schema:
        type: object
        additionalProperties: false
        required: [text]
        properties:
          text: { type: string, minLength: 1 }

  critique_2:
    with:
      candidate: ${{ tasks.repair_1.output.text }}
    infer:
      max_tokens: 400
      prompt: "Critique this revision against the brief and name one repair. Brief: ${{ const.brief }} Candidate: ${{ with.candidate }}"
      schema:
        type: object
        additionalProperties: false
        required: [score, repair]
        properties:
          score: { type: integer, minimum: 0, maximum: 100 }
          repair: { type: string, minLength: 1 }

  repair_2:
    with:
      candidate: ${{ tasks.repair_1.output.text }}
      repair: ${{ tasks.critique_2.output.repair }}
    infer:
      max_tokens: 400
      prompt: "Produce the final revision using the repair. Candidate: ${{ with.candidate }} Repair: ${{ with.repair }}"
      schema:
        type: object
        additionalProperties: false
        required: [text]
        properties:
          text: { type: string, minLength: 1 }

  final_score:
    with:
      candidate: ${{ tasks.repair_2.output.text }}
    infer:
      max_tokens: 400
      prompt: "Score the final candidate against the brief, exactly as written. Brief: ${{ const.brief }} Candidate: ${{ with.candidate }}"
      schema:
        type: object
        additionalProperties: false
        required: [score]
        properties:
          score: { type: integer, minimum: 0, maximum: 100 }

  verdict:
    with:
      score: ${{ tasks.final_score.output.score }}
      text: ${{ tasks.repair_2.output.text }}
    infer:
      max_tokens: 300
      prompt: "The final score is ${{ with.score }} and the bar is ${{ const.accept_at }}. Decide whether the text is accepted. Text: ${{ with.text }}"
      schema:
        type: object
        additionalProperties: false
        required: [accepted, final_score, rounds, released]
        properties:
          accepted: { type: boolean }
          final_score: { type: integer }
          rounds: { type: integer }
          released: { type: string }

outputs:
  accepted: ${{ tasks.verdict.output.accepted }}
  final_score: ${{ tasks.verdict.output.final_score }}
  rounds: ${{ tasks.verdict.output.rounds }}
  released: ${{ tasks.verdict.output.released }}
