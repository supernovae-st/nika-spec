# Expected: exit 0 — exec stdout captured, then nika:convert csv→json.
nika: c22-convert-builtin

permits:
  fs:
    write: ["./out/content/c22-result.json"]
  exec: ["printf"]
  tools: ["nika:convert", "nika:write"]

tasks:
  csv_data:
    exec:
      # No surrounding quotes: argv is execve, so a leading/trailing ' is DATA,
      # not shell quoting — it emitted a 1-field 4th record and CSV refused it.
      command: ["printf", "name,role,score\\nAlice,writer,9\\nBob,editor,7\\nCarol,reviewer,8\\n"]
      capture: stdout

  to_json:
    with:
      csv_data: ${{ tasks.csv_data.output }}
    invoke:
      tool: "nika:convert"
      args:
        input: "${{ with.csv_data }}"
        from: csv
        to: json
        has_header: true

  result:
    with:
      to_json: ${{ tasks.to_json.output }}
    invoke:
      tool: "nika:write"
      args:
        path: "./out/content/c22-result.json"
        content: "${{ with.to_json }}"
        create_dirs: true
