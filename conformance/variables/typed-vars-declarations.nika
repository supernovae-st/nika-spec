# Expected: exit 0 — typed const declarations (type + value) resolve.
# W18: typed const — string/number/boolean declarations
# Tests: typed const (string/number/boolean) accessible in CEL
nika: w18-typed-vars

const:
  username:
    type: string
    value: "alice"
  score:
    type: number
    value: 99.5
  enabled:
    type: bool
    value: true

permits:
  fs:
    write: ["./out/data-validation/w18-typed-vars.json"]
  exec: false
  tools: ["nika:assert", "nika:write"]

tasks:
  check_string:
    invoke:
      tool: "nika:assert"
      args:
        condition: "${{ const.username == 'alice' }}"
        message: "username must be alice"

  check_number:
    after:
      check_string: success
    invoke:
      tool: "nika:assert"
      args:
        condition: "${{ const.score > 90 }}"
        message: "score must be > 90"

  check_boolean:
    after:
      check_number: success
    invoke:
      tool: "nika:assert"
      args:
        condition: "${{ const.enabled == true }}"
        message: "enabled must be true"

  write_result:
    after:
      check_boolean: success
    invoke:
      tool: "nika:write"
      args:
        path: "./out/data-validation/w18-typed-vars.json"
        content:
          username: "${{ const.username }}"
          score: ${{ const.score }}
          enabled: ${{ const.enabled }}
        create_dirs: true
