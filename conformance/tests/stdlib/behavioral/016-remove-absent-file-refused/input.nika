# Stdlib BEHAVIORAL · a permitted path naming nothing fails; no missing-ok.
# Authored contract · native observation pending.
nika: rt-stdlib-remove-absent-refused
permits:
  tools: ["nika:remove_file"]
  fs: { write: ["./out/**"] }
tasks:
  drop:
    invoke:
      tool: "nika:remove_file"
      args: { path: "./out/missing/nested.txt" }
