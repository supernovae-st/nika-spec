# SPDX-License-Identifier: Apache-2.0
{
  "nika": "fetch-observation",
  "permits": {
    "tools": [
      "nika:fetch",
      "nika:jq"
    ],
    "net": {
      "http": [
        "example.test",
        "final.example.test"
      ]
    }
  },
  "tasks": {
    "policy": {
      "invoke": {
        "tool": "nika:jq",
        "args": {
          "input": {
            "policy": null
          },
          "expression": ".policy"
        }
      }
    },
    "probe": {
      "invoke": {
        "tool": "nika:fetch",
        "args": {
          "url": "https://example.test/probe",
          "method": "GET",
          "mode": "raw",
          "response": "${{ with.policy }}"
        }
      },
      "with": {
        "policy": "${{ tasks.policy.output }}"
      }
    }
  }
}
