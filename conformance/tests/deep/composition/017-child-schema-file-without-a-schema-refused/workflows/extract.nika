# SPDX-License-Identifier: Apache-2.0
nika: comp-extract-schema-file
permits:
  fs: { read: ["../schemas/**"] }
tasks:
  extract:
    infer:
      prompt: "Find the order number in: order 42 shipped"
      schema: { file: "../schemas/order.json" }
outputs:
  order: ${{ tasks.extract.output.order }}
