# SPDX-License-Identifier: Apache-2.0
nika: file-acp-standard-not-assumed
model: openai/gpt-5.5
run:
  access:
    via: codex
    protocol: acp
    fallback: none
    service_tier: standard
  reasoning:
    effort: high
tasks:
  summarize:
    agent:
      prompt: "Summarize the supplied note in one sentence."
