# SPDX-License-Identifier: Apache-2.0
# Runtime BEHAVIORAL · secrets · the executable twin of
# envelope/secrets-outputs-egress-sanctioned.nika, under a jq egress rule and
# an outputs egress rule (spec 01 §egress). The secret is synthetic and
# supplied by run.json. The sanctioned workflow completes and the derive task
# is observed as the JSON boolean true, never the string "true" nor the
# secret itself. This fixture does not assert the workflow's exported value;
# output export and secret masking require their own observed door.
nika: rt-secrets-derived-output-egress
permits:
  tools: ["nika:jq"]
secrets:
  api_key:
    source: env
    key: FAKE_API_KEY_FOR_TEST
    egress:
      - { to: "nika:jq" }
      - { to: "outputs" }
tasks:
  derive:
    with: { k: "${{ secrets.api_key }}" }
    invoke:
      tool: "nika:jq"
      args: { input: "${{ with.k }}", expression: "length > 0" }
outputs:
  exported: "${{ tasks.derive.output }}"
