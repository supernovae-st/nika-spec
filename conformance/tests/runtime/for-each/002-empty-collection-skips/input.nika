# SPDX-License-Identifier: Apache-2.0
nika: rt-foreach-empty-skips
model: mock/echo
const:
  items: []
tasks:
  work:
    for_each:
      items: ${{ const.items }}
    infer: { prompt: "never runs" }
  reader:
    with:
      result: ${{ tasks.work.output }}
    when: ${{ with.result == null }}
    infer: { prompt: "the empty branch" }
