# SPDX-License-Identifier: Apache-2.0
nika: rt-foreach-non-array
model: mock/echo
tasks:
  source:
    invoke:
      tool: "nika:jq"
      args: { input: null, expression: '"just a string"' }
  work:
    with:
      collection: ${{ tasks.source.output }}
    for_each:
      items: ${{ with.collection }}
    infer: { prompt: "never runs" }
